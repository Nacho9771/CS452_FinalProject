# Copy to .env, which is ignored by Git. Never commit real credentials.
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=C:/path/outside/repository/firebase-service-account.json
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=my_kitchen
# Optional alternative: set BOTH separately; they override URI credentials.
# MONGODB_USERNAME=your-database-user
# MONGODB_PASSWORD=your-database-password
# Optional local sign-in helper; disabled unless explicitly set to 1.
ENABLE_DEV_SIGNIN=0
FIREBASE_WEB_API_KEY=public-firebase-web-api-key
FIREBASE_WEB_APP_ID=public-firebase-web-app-id
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
